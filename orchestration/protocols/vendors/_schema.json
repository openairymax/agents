{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airymax.dev/ecosystem/agents/orchestration/protocols/vendors/_schema.json",
  "title": "Protocol Vendor Manifest",
  "description": "L3 策略注入面：协议厂商/框架的策略数据。机制（传输、JSON-RPC 编解码骨架、重试/退避/心跳/重连状态机、注册表）唯一实现在 agentrt/protocols/core，本清单仅描述策略；改动某字段会改变产品行为语义者入清单，纯实现常量（日志标签、错误码基址、哈希常量、缓冲区/分块尺寸、socket 语义宏）不入清单。",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "kind", "protocol"],
  "properties": {
    "manifest_version": {
      "const": 1,
      "description": "清单结构版本"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "清单唯一标识（小写下划线）"
    },
    "kind": {
      "enum": ["core", "standard", "integration", "framework"],
      "description": "对应 agentrt proto_category_t"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "registry": {
      "type": "object",
      "description": "内置注册表元数据；仅被 agentrt 预置注册的厂商具备此块（自注册数据源）",
      "additionalProperties": false,
      "required": ["name", "version", "description", "category", "type", "capabilities"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["core", "standard", "integration", "framework"]
        },
        "type": {
          "enum": ["jsonrpc", "mcp", "a2a", "openai", "openjiuwen", "claude", "china_eco", "agntcy", "openclaw"]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sync_request", "streaming", "bidirectional", "tool_discovery",
              "resource_access", "agent_discovery", "task_lifecycle",
              "function_calling", "embeddings", "authentication", "rate_limiting",
              "negotiation", "notifications", "custom", "batch", "tool_calling",
              "consensus", "binary", "low_latency", "crc_checksum", "multimodal",
              "vision", "extended_thinking", "code_execution", "human_loop"
            ]
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["http", "stdio", "tcp", "unix_socket", "custom_binary"]
        },
        "endpoint_default": {
          "type": "string"
        },
        "path_prefix": {
          "type": "string"
        },
        "wire_version": {
          "type": "string"
        },
        "magic_prefix": {
          "type": "string"
        },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "magic": {
              "type": "string"
            },
            "header_separator": {
              "type": "string"
            },
            "terminator": {
              "type": "string"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "容量上限（容量口径为厂商策略）",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
      "description": "超时（毫秒）",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "base_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_consecutive_errors": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "heartbeat_interval_sec": {
      "type": "integer",
      "minimum": 0
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpm": {
          "type": "integer",
          "minimum": 0
        },
        "tpm": {
          "type": "integer",
          "minimum": 0
        },
        "window_sec": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "认证参数（长度/次数/有效期）",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "crypto": {
      "type": "object",
      "description": "加密参数（密钥/摘要/块尺寸）",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ids": {
      "type": "object",
      "description": "标识序列长度（字节/字符）",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "enums": {
      "type": "object",
      "description": "协议线枚举（厂商线格式常量）",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}

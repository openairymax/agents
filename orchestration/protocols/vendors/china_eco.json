{
  "manifest_version": 1,
  "id": "china_eco",
  "kind": "integration",
  "protocol": {
    "name": "china-eco",
    "version": "0.1.0"
  },
  "registry": {
    "name": "ChinaEco",
    "version": "1.0",
    "description": "国内大模型生态统一兼容适配器",
    "category": "integration",
    "type": "china_eco",
    "capabilities": ["streaming", "tool_calling", "embeddings"]
  },
  "transport": {
    "kind": "http"
  },
  "limits": {
    "max_providers": 16,
    "max_endpoints": 64,
    "max_message_size": 16777216
  },
  "timeouts": {
    "default_ms": 30000
  },
  "crypto": {
    "sm2_key_size": 64,
    "sm3_hash_size": 32,
    "sm3_digest_size": 32,
    "sm4_block_size": 16,
    "sm4_key_size": 16,
    "sm4_iv_size": 16
  }
}

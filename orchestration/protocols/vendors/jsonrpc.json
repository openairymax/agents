{
  "manifest_version": 1,
  "id": "jsonrpc",
  "kind": "core",
  "protocol": {
    "name": "jsonrpc",
    "version": "2.0"
  },
  "registry": {
    "name": "JSON-RPC",
    "version": "2.0",
    "description": "原生JSON-RPC 2.0协议适配器",
    "category": "core",
    "type": "jsonrpc",
    "capabilities": ["streaming", "batch"]
  },
  "interface": {
    "methods": [
      "agent.list", "agent.create", "agent.destroy",
      "skill.list", "skill.execute", "skill.install",
      "task.submit", "task.query", "task.cancel",
      "memory.write", "memory.search", "memory.evolve",
      "session.create", "session.close"
    ],
    "invoke": {
      "style": "jsonrpc2",
      "path": "/rpc"
    }
  },
  "transport": {
    "kind": "http"
  }
}

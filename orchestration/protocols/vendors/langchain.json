{
  "manifest_version": 1,
  "id": "langchain",
  "kind": "framework",
  "protocol": {
    "name": "langchain",
    "version": "1.0.0"
  },
  "limits": {
    "max_chains": 64,
    "max_tools": 128,
    "max_agents": 32,
    "max_memory_entries": 1024
  },
  "timeouts": {
    "default_ms": 60000
  }
}

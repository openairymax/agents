{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openairymax.example/schemas/agent.schema.json",
  "title": "Airymax Agent Contract",
  "description": "Machine-verifiable JSON Schema for Airymax Agent contract.json files. Spec reference: docs/AirymaxRT/20-modules/10-contracts/01-agent-contract.md (Airymax Agent Contract v1.0.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "agent_name",
    "version",
    "role",
    "description",
    "capabilities",
    "models",
    "required_permissions",
    "cost_profile",
    "trust_metrics"
  ],
  "properties": {
    "schema_version": {
      "description": "Contract schema version (SemVer).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "agent_id": {
      "description": "Globally-unique agent identifier in the form `<role>_v<major>` (e.g. `product_manager_v1`).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
    },
    "agent_name": {
      "description": "Human-readable display name.",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "description": "Implementation version (SemVer).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "role": {
      "description": "Role classifier; must match the prefix of agent_id (sans `_v<n>` suffix).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "models": {
      "description": "Thinkdual dual-system model configuration: system1 (fast) + system2 (main). Each entry may be a bare model-id string or a richer object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["system1", "system2"],
      "properties": {
        "system1": {"$ref": "#/$defs/model"},
        "system2": {"$ref": "#/$defs/model"}
      }
    },
    "required_permissions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "cost_profile": {"$ref": "#/$defs/costProfile"},
    "trust_metrics": {"$ref": "#/$defs/trustMetrics"},
    "extensions": {
      "description": "Optional provider-specific extensions.",
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "input_schema", "output_schema"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {"type": "string", "minLength": 1},
        "input_schema": {"$ref": "#/$defs/jsonSchemaObject"},
        "output_schema": {"$ref": "#/$defs/jsonSchemaObject"},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "avg_duration_ms": {"type": "integer", "minimum": 0},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "model": {
      "description": "Model reference: a bare model-id string (e.g. \"gpt-4o-mini\") or a richer config object.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1},
            "purpose": {"type": "string"},
            "max_tokens": {"type": "integer", "minimum": 1},
            "temperature": {"type": "number", "minimum": 0, "maximum": 2},
            "priority": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "costProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_per_task_avg": {"type": "integer", "minimum": 0},
        "api_cost_per_task": {"type": "number", "minimum": 0},
        "maintenance_level": {
          "type": "string",
          "enum": ["community", "vendor", "core"]
        },
        "input_token_cost_per_1k": {"type": "number", "minimum": 0},
        "output_token_cost_per_1k": {"type": "number", "minimum": 0},
        "avg_tokens_per_task": {"type": "integer", "minimum": 0},
        "estimated_cost_per_task_usd": {"type": "number", "minimum": 0},
        "monthly_budget_usd": {"type": "number", "minimum": 0},
        "cost_center": {"type": "string"}
      }
    },
    "trustMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install_count": {"type": "integer", "minimum": 0},
        "rating": {"type": "number", "minimum": 0, "maximum": 5},
        "verified_provider": {"type": "boolean"},
        "last_audit": {"type": "string", "format": "date"},
        "trust_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability_score": {"type": "number", "minimum": 0, "maximum": 1},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
        "security_score": {"type": "number", "minimum": 0, "maximum": 1},
        "total_tasks_completed": {"type": "integer", "minimum": 0},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "avg_user_rating": {"type": "number", "minimum": 0, "maximum": 5},
        "last_evaluation": {"type": "string"}
      }
    },
    "jsonSchemaObject": {
      "description": "A JSON-Schema fragment describing capability input/output payload shape.",
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "items": {"type": "object"},
        "description": {"type": "string"}
      }
    }
  }
}
